DISCORD_TOKEN=put_your_bot_token_here

# Discord OAuth2 (keep CLIENT_SECRET server-side only)
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
DISCORD_REDIRECT_URI=https://your-backend.example.com/oauth/callback

# Public backend URL used by the GitHub Pages frontend
PUBLIC_BACKEND_URL=https://your-backend.example.com
WEB_ORIGIN=https://yourname.github.io

# Optional
DINO_DB=dino.sqlite3
PORT=8080
